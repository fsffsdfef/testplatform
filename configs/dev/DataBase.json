{
  "default": {
        "ENGINE": "django.db.backends.mysql",
        "NAME": "${DB_NAME}",
        "USER": "${DB_USER}",
        "PASSWORD": "${DB_PASSWORD}",
        "HOST": "${DB_HOST}",
        "PORT": "${DB_PORT}",
        "OPTIONS": {
            "charset": "utf8mb4",
            "init_command": "SET time_zone = '+8:00'"
        }
    }
}