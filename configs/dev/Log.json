 {
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "detailed": {
            "format": "[{asctime}] {levelname} [{name}:{lineno}] {message}",
            "style": "{",
            "datefmt": "%Y-%m-%d %H:%M:%S"
        }
    },
    "handlers": {
        "console": {
            "level": "INFO",
            "class": "logging.StreamHandler",
            "formatter": "detailed"
        },
        "database": {
            "level": "INFO",
            "class": "commons.cusntom.handler.DatabaseLogHandler"
        },
        "file": {
            "level": "DEBUG",
            "class":"logging.handlers.RotatingFileHandler",
            "filename": "logs/debug.log",
            "backupCount": 5,
            "formatter": "detailed",
            "encoding": "utf-8"
        }
    },

     "root": {
        "handlers": ["console", "database", "file"],
        "level": "INFO"
    },
    "loggers": {
        "django": {
            "handlers": ["console", "database", "file"],
            "level": "INFO",
            "propagate": false
        },
        "django.request": {
            "handlers": ["database", "file"],
            "level": "INFO",
            "propagate": false
        },
        "celery": {
            "handlers": ["console", "database"],
            "level": "INFO",
            "propagate": false
        },
        "apps.cases": {
            "handlers": ["console", "database", "file"],
            "level": "INFO",
            "propagate": false
        },
        "commons.abs.baserequest": {
            "handlers": ["console", "database", "file"],
            "level": "INFO",
            "propagate": false
        }
    }
}